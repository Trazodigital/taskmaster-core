#!/usr/bin/env bash
# commit-msg — product git hook.
#
# Byte-for-byte behavior of .framework/templates/hooks/commit-msg. It is copied
# into the product only because core.hooksPath points at this directory instead
# (see .githooks/pre-push for why); repointing without copying this hook would
# silently drop commit-message enforcement.
#
# Enable with:  git config core.hooksPath .githooks
#
# git passes the path to the prepared commit message as $1.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
FW="$ROOT/.framework/scripts"

# If the framework submodule isn't initialised, don't block the commit.
[ -x "$FW/check-commit-message.sh" ] || exit 0

QF_ROOT="$ROOT" "$FW/check-commit-message.sh" --file "$1" >/dev/null
