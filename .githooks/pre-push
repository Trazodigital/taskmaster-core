#!/usr/bin/env bash
# pre-push — product git hook.
#
# Same contract as .framework/templates/hooks/pre-push, with one addition:
# architecture branches are validated against their own convention.
#
# workflows/sdd-architecture.md Preconditions #3 mandates an `arch/<slug>`
# branch, but check-branch-name.sh exempts only main/master/develop/HEAD and
# release/*, with the list hardcoded and no override flag. The framework
# therefore rejects a branch it requires. The hook lives in the framework
# submodule, so it cannot be corrected in place without the change being lost
# on the next submodule update — hence this product-owned copy.
#
# Architecture branches are NOT skipped here; they are held to
# ^arch/[a-z][a-z0-9-]*$. Every other branch is delegated to the framework gate
# unchanged. This mirrors the track split in
# scripts/local_dry_CI_run_before_commit.sh and .github/workflows/quality-gates.yml.
#
# Enable with:  git config core.hooksPath .githooks
#
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
FW="$ROOT/.framework/scripts"

# If the framework submodule isn't initialised, don't block the push.
[ -x "$FW/check-branch-name.sh" ] || exit 0

check_branch() {
  local branch="$1"
  case "$branch" in
    arch/*)
      if printf '%s' "$branch" | grep -qE '^arch/[a-z][a-z0-9-]*$'; then
        return 0
      fi
      echo "pre-push: hard-gate: architecture branch '$branch' must match 'arch/<slug>' (slug: ^[a-z][a-z0-9-]*\$)" >&2
      return 1
      ;;
    *)
      QF_ROOT="$ROOT" "$FW/check-branch-name.sh" --branch "$branch" >/dev/null
      ;;
  esac
}

status=0
seen=0
while read -r local_ref _ _ _; do
  case "$local_ref" in
    refs/heads/*)
      seen=1
      check_branch "${local_ref#refs/heads/}" || status=1
      ;;
  esac
done

# Manual run (no stdin refs): fall back to the current branch.
if [ "$seen" -eq 0 ]; then
  check_branch "$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)" || status=1
fi

exit "$status"
