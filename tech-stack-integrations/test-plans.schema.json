{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai/quality-framework/tech-stack-integrations/test-plans.schema.json",
  "title": "Test Plans (Acceptance) Interaction Contract",
  "description": "Validates tech-stack-integrations/test-plans.yaml. Template values matching '<PLACEHOLDER>' are accepted so an unfilled template still validates structurally; skills MUST hard-gate on placeholders at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "auth", "project", "test_id", "acceptance_export", "results", "gate"],
  "properties": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "interaction_mode"],
      "properties": {
        "name": { "$ref": "#/$defs/stringOrPlaceholder" },
        "interaction_mode": {
          "oneOf": [
            { "enum": ["export-file", "rest-api"] },
            { "const": "<PLACEHOLDER>" }
          ]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "credential_key"],
      "properties": {
        "mode": {
          "oneOf": [
            { "enum": ["none", "token", "pat", "oauth"] },
            { "const": "<PLACEHOLDER>" }
          ]
        },
        "credential_key": { "$ref": "#/$defs/stringOrPlaceholder" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["org", "name"],
      "properties": {
        "org": { "$ref": "#/$defs/stringOrPlaceholder" },
        "name": { "$ref": "#/$defs/stringOrPlaceholder" }
      }
    },
    "test_id": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "verifies_syntax"],
      "properties": {
        "pattern": { "$ref": "#/$defs/stringOrPlaceholder" },
        "verifies_syntax": { "$ref": "#/$defs/stringOrPlaceholder" }
      }
    },
    "acceptance_export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "refresh"],
      "properties": {
        "path": { "$ref": "#/$defs/stringOrPlaceholder" },
        "format": {
          "oneOf": [
            { "enum": ["json", "csv"] },
            { "const": "<PLACEHOLDER>" }
          ]
        },
        "refresh": { "$ref": "#/$defs/stringOrPlaceholder" }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "accepted_when"],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] }
        },
        "accepted_when": { "const": "PASS" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks_merge", "on_missing_export", "on_fail_at_release"],
      "properties": {
        "blocks_merge": { "const": "never" },
        "on_missing_export": { "const": "unknown" },
        "on_fail_at_release": { "const": "hard-gate" }
      }
    }
  },
  "$defs": {
    "stringOrPlaceholder": {
      "type": "string",
      "minLength": 1
    }
  }
}
