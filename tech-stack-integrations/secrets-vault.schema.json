{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai/quality-framework/tech-stack-integrations/secrets-vault.schema.json",
  "title": "Secrets Vault Interaction Contract",
  "description": "Validates tech-stack-integrations/secrets-vault.yaml. Template values matching '<PLACEHOLDER>' are accepted so an unfilled template still validates structurally; skills MUST hard-gate on placeholders at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "auth",
    "naming",
    "commands",
    "gate"
  ],
  "properties": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "interaction_mode"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/stringOrPlaceholder"
        },
        "interaction_mode": {
          "oneOf": [
            {
              "enum": [
                "rest-api",
                "cli",
                "sdk"
              ]
            },
            {
              "const": "<PLACEHOLDER>"
            }
          ]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_mode",
        "ci_mode"
      ],
      "properties": {
        "runtime_mode": {
          "oneOf": [
            {
              "enum": [
                "workload-identity",
                "managed-identity",
                "service-account",
                "token"
              ]
            },
            {
              "const": "<PLACEHOLDER>"
            }
          ]
        },
        "ci_mode": {
          "oneOf": [
            {
              "enum": [
                "oidc",
                "service-principal",
                "token"
              ]
            },
            {
              "const": "<PLACEHOLDER>"
            }
          ]
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_pattern",
        "scope_prefix"
      ],
      "properties": {
        "path_pattern": {
          "$ref": "#/$defs/stringOrPlaceholder"
        },
        "scope_prefix": {
          "$ref": "#/$defs/stringOrPlaceholder"
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fetch_runtime",
        "fetch_ci",
        "scan_source"
      ],
      "properties": {
        "fetch_runtime": {
          "$ref": "#/$defs/shellCommandTemplate"
        },
        "fetch_ci": {
          "$ref": "#/$defs/shellCommandTemplate"
        },
        "scan_source": {
          "$ref": "#/$defs/shellCommandTemplate"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_hardcoded_secret",
        "on_credential_key_pattern_mismatch",
        "on_missing_env_declaration",
        "on_fetch_failure"
      ],
      "properties": {
        "on_hardcoded_secret": {
          "const": "hard-gate"
        },
        "on_credential_key_pattern_mismatch": {
          "const": "hard-gate"
        },
        "on_missing_env_declaration": {
          "const": "hard-gate"
        },
        "on_fetch_failure": {
          "const": "hard-gate"
        }
      }
    }
  },
  "$defs": {
    "stringOrPlaceholder": {
      "type": "string",
      "minLength": 1
    },
    "shellCommandTemplate": {
      "description": "A shell command invoked verbatim by skills. Every {token} must be single-quoted: '{id}'. An unquoted token whose value carries a '#' prefix truncates the command at the shell comment character, silently discarding every argument after it.",
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "(^|[^'])\\{[a-z_]+\\}"
          },
          {
            "pattern": "\\{[a-z_]+\\}($|[^'])"
          }
        ]
      }
    }
  }
}
