{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai/quality-framework/tech-stack-integrations/build-pipeline.schema.json",
  "title": "Build & Release Pipeline Interaction Contract",
  "description": "Validates tech-stack-integrations/build-pipeline.yaml. Template values matching '<PLACEHOLDER>' are accepted so an unfilled template still validates structurally; skills MUST hard-gate on placeholders at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "suites",
    "artifacts",
    "branch_protection",
    "merge_policy",
    "deployment",
    "gate",
    "architecture_suites"
  ],
  "properties": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "interaction_mode"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/stringOrPlaceholder"
        },
        "interaction_mode": {
          "oneOf": [
            {
              "enum": [
                "hosted-yaml",
                "cli",
                "rest-api"
              ]
            },
            {
              "const": "<PLACEHOLDER>"
            }
          ]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "oneOf": [
            {
              "enum": [
                "none",
                "token",
                "oauth",
                "basic"
              ]
            },
            {
              "const": "<PLACEHOLDER>"
            }
          ]
        },
        "credential_key": {
          "$ref": "#/$defs/stringOrPlaceholder"
        }
      }
    },
    "suites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lint",
        "format-check",
        "type-check",
        "test-unit",
        "test-integration",
        "test-security",
        "security-scan",
        "test-e2e",
        "bench",
        "docs-build",
        "schema-validation",
        "traceability-gate",
        "glossary-gate",
        "docs-layout-gate",
        "integration-consistency-gate",
        "uid-uniqueness-gate",
        "relations-gate",
        "framework-feedback-gate",
        "branch-protection-gate",
        "nfr-fields-gate",
        "design-review-gate",
        "design-review-gate-arch",
        "traceability-gate-arch",
        "module-structure-gate",
        "docs-overview-gate"
      ],
      "properties": {
        "lint": {
          "$ref": "#/$defs/placeholderSuite"
        },
        "format-check": {
          "$ref": "#/$defs/placeholderSuite"
        },
        "type-check": {
          "$ref": "#/$defs/placeholderSuite"
        },
        "test-unit": {
          "$ref": "#/$defs/placeholderSuite"
        },
        "test-integration": {
          "$ref": "#/$defs/placeholderSuite"
        },
        "test-security": {
          "$ref": "#/$defs/placeholderSuite"
        },
        "security-scan": {
          "$ref": "#/$defs/placeholderSuite"
        },
        "test-e2e": {
          "$ref": "#/$defs/placeholderSuite"
        },
        "bench": {
          "$ref": "#/$defs/placeholderSuite"
        },
        "docs-build": {
          "$ref": "#/$defs/placeholderSuite"
        },
        "schema-validation": {
          "$ref": "#/$defs/placeholderSuite"
        },
        "traceability-gate": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-traceability.sh --phase verify --check-logging"
            }
          }
        },
        "glossary-gate": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-glossary.sh"
            }
          }
        },
        "docs-layout-gate": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-docs-layout.sh"
            }
          }
        },
        "integration-consistency-gate": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-integration-consistency.sh"
            }
          }
        },
        "uid-uniqueness-gate": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-uid-uniqueness.sh"
            }
          }
        },
        "relations-gate": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-relations.sh"
            }
          }
        },
        "framework-feedback-gate": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-framework-feedback.sh"
            }
          }
        },
        "branch-protection-gate": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-branch-protection.sh"
            }
          }
        },
        "nfr-fields-gate": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-nfr-fields.sh"
            }
          }
        },
        "design-review-gate": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-design-review.sh"
            }
          }
        },
        "design-review-gate-arch": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-design-review.sh --scope architecture"
            }
          }
        },
        "traceability-gate-arch": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-traceability.sh --phase verify --architecture-only"
            }
          }
        },
        "module-structure-gate": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-module-structure.sh"
            }
          }
        },
        "docs-overview-gate": {
          "$ref": "#/$defs/scriptedSuite",
          "properties": {
            "command": {
              "const": ".framework/scripts/check-traceability.sh --report --overview --check"
            }
          }
        }
      },
      "description": "Framework-fixed suites are declared in `properties`, their commands are locked so a product cannot repoint a gate at something weaker, and as of 3.0.0 every one of them is `required` — a pipeline that does not declare a framework gate no longer validates. Between 1.6.0 and 3.0.0 newly added suites were listed but not required, so a product could upgrade before rewiring its pipeline; that staging period is over and the batch landed together, which is the point of putting it on a major. A product MAY declare its own gates under a `product-` prefix — the namespace exists so a product-specific check is never smuggled in under a framework name like `lint`, which would make the pipeline describe something it is not running.",
      "patternProperties": {
        "^product-[a-z0-9]+(-[a-z0-9]+)*$": {
          "description": "A product-defined gate. Free-form command; the framework does not constrain it.",
          "$ref": "#/$defs/placeholderSuite"
        }
      }
    },
    "architecture_suites": {
      "type": "array",
      "description": "The subset of `suites` that runs on an `arch/<slug>` branch. The architecture track authors requirements and carries no implementation by design, so the code-shaped suites cannot pass there and holding an architecture PR to them makes a correct architecture PR unmergeable. Entries SELECT existing suites by name — they never define a suite or a command, so this list cannot weaken a gate, only choose which gates apply. Every entry MUST also be a key under `suites`; that cross-reference is not expressible in JSON Schema and is enforced by check-integration-consistency.sh. Optional: a product that never uses the architecture track may omit it, in which case an arch branch runs the full suite set.",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "enum": [
              "lint",
              "format-check",
              "type-check",
              "security-scan",
              "traceability-gate-arch",
              "docs-overview-gate",
              "glossary-gate",
              "docs-layout-gate",
              "integration-consistency-gate",
              "uid-uniqueness-gate",
              "relations-gate",
              "framework-feedback-gate",
              "branch-protection-gate",
              "nfr-fields-gate",
              "design-review-gate-arch",
              "module-structure-gate",
              "docs-build",
              "schema-validation"
            ]
          },
          {
            "pattern": "^product-[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          }
        ]
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lint-report",
        "junit-xml",
        "coverage",
        "sarif",
        "benchmark-report",
        "heap-snapshot",
        "e2e-video",
        "traceability-matrix",
        "docs-site"
      ],
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "$ref": "#/$defs/artifactSpec"
        }
      }
    },
    "branch_protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protected_branches",
        "required_checks",
        "min_reviewers",
        "require_codeowners_review",
        "require_linear_history",
        "allow_force_push",
        "allow_deletion"
      ],
      "properties": {
        "protected_branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "min_reviewers": {
          "type": "integer",
          "minimum": 1
        },
        "require_codeowners_review": {
          "const": true
        },
        "require_linear_history": {
          "const": true
        },
        "allow_force_push": {
          "const": false
        },
        "allow_deletion": {
          "const": false
        },
        "enforcement": {
          "description": "Where the policy above is actually enforced. The policy fields state what the project REQUIRES; this states what stops a bad merge. Optional for backward compatibility — absent means unknown, and check-branch-protection.sh warns. It becomes required in a later minor.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mechanism"
          ],
          "properties": {
            "mechanism": {
              "oneOf": [
                {
                  "enum": [
                    "host-native",
                    "manual-process",
                    "none"
                  ]
                },
                {
                  "const": "<PLACEHOLDER>"
                }
              ]
            },
            "verified_by": {
              "$ref": "#/$defs/stringOrPlaceholder"
            },
            "unenforceable_reason": {
              "$ref": "#/$defs/stringOrPlaceholder"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mechanism": {
                    "const": "host-native"
                  }
                },
                "required": [
                  "mechanism"
                ]
              },
              "then": {
                "required": [
                  "verified_by"
                ],
                "description": "A host-native claim must be checkable, or it is just an assertion."
              }
            },
            {
              "if": {
                "properties": {
                  "mechanism": {
                    "enum": [
                      "manual-process",
                      "none"
                    ]
                  }
                },
                "required": [
                  "mechanism"
                ]
              },
              "then": {
                "required": [
                  "unenforceable_reason"
                ],
                "description": "Declaring the policy unenforced requires saying why, so the gap is a recorded decision rather than a silent one."
              }
            }
          ]
        }
      }
    },
    "merge_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "require_pr_checklist"
      ],
      "properties": {
        "strategy": {
          "oneOf": [
            {
              "enum": [
                "merge-commit",
                "squash",
                "rebase"
              ]
            },
            {
              "const": "<PLACEHOLDER>"
            }
          ]
        },
        "require_pr_checklist": {
          "const": true
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staging",
        "production"
      ],
      "properties": {
        "staging": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trigger",
            "requires_suites"
          ],
          "properties": {
            "trigger": {
              "$ref": "#/$defs/stringOrPlaceholder"
            },
            "requires_suites": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "production": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trigger",
            "requires_gates"
          ],
          "properties": {
            "trigger": {
              "$ref": "#/$defs/stringOrPlaceholder"
            },
            "requires_gates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "nfr-threshold-check",
                  "po-acceptance"
                ]
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_suite_failure",
        "on_missing_artifact",
        "on_branch_protection_bypass",
        "on_missing_review",
        "on_nfr_regression",
        "on_missing_po_approval"
      ],
      "properties": {
        "on_suite_failure": {
          "const": "hard-gate"
        },
        "on_missing_artifact": {
          "const": "hard-gate"
        },
        "on_branch_protection_bypass": {
          "const": "hard-gate"
        },
        "on_missing_review": {
          "const": "hard-gate"
        },
        "on_nfr_regression": {
          "const": "hard-gate"
        },
        "on_missing_po_approval": {
          "const": "hard-gate"
        }
      }
    }
  },
  "$defs": {
    "stringOrPlaceholder": {
      "type": "string",
      "minLength": 1
    },
    "triggerEnum": {
      "enum": [
        "push",
        "pr",
        "tag",
        "release-branch",
        "schedule",
        "manual"
      ]
    },
    "placeholderSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "triggers",
        "blocking",
        "artifacts"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/stringOrPlaceholder"
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/triggerEnum"
          }
        },
        "blocking": {
          "const": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scriptedSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "triggers",
        "blocking",
        "artifacts"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/triggerEnum"
          }
        },
        "blocking": {
          "const": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifactSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "retention"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "oneOf": [
            {
              "enum": [
                "per-release",
                "historical"
              ]
            },
            {
              "type": "string",
              "pattern": "^[0-9]+d$"
            }
          ]
        }
      }
    }
  }
}
