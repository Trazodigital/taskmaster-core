{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai/quality-framework/tech-stack-integrations/requirements-tracker.schema.json",
  "title": "Requirements Tracker Interaction Contract",
  "description": "Validates tech-stack-integrations/requirements-tracker.yaml. Template values matching '<PLACEHOLDER>' are accepted so an unfilled template still validates structurally; skills MUST hard-gate on placeholders at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "storage", "uid", "markers", "commands", "nfr_fields", "gate"],
  "properties": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "interaction_mode"],
      "properties": {
        "name": { "$ref": "#/$defs/stringOrPlaceholder" },
        "interaction_mode": {
          "oneOf": [
            { "enum": ["local-files", "cli", "rest-api", "webhook"] },
            { "const": "<PLACEHOLDER>" }
          ]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "oneOf": [
            { "enum": ["none", "token", "oauth", "basic"] },
            { "const": "<PLACEHOLDER>" }
          ]
        },
        "credential_key": { "$ref": "#/$defs/stringOrPlaceholder" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements_dir", "file_extension", "one_file_per", "glossary_file"],
      "properties": {
        "requirements_dir": { "const": "docs/requirements" },
        "file_extension": { "$ref": "#/$defs/stringOrPlaceholder" },
        "one_file_per": {
          "oneOf": [
            { "enum": ["feature", "requirement", "project"] },
            { "const": "<PLACEHOLDER>" }
          ]
        },
        "glossary_file": { "const": "docs/glossary.md" }
      }
    },
    "uid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "types", "uniqueness_check"],
      "properties": {
        "pattern": { "const": "REQ-[A-Z]+-[0-9]+" },
        "types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z-]*$" }
        },
        "uniqueness_check": { "$ref": "#/$defs/stringOrPlaceholder" }
      }
    },
    "markers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syntax", "comment_style", "scan_paths", "ignore_paths"],
      "properties": {
        "syntax": { "const": "@sdoc[<UID>]" },
        "comment_style": {
          "oneOf": [
            { "enum": ["jsdoc", "python-docstring", "godoc", "rustdoc"] },
            { "const": "<PLACEHOLDER>" }
          ]
        },
        "scan_paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "ignore_paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validate_corpus", "export_matrix", "check_uniqueness", "check_glossary", "check_nfr_fields", "check_traceability"],
      "properties": {
        "validate_corpus": { "$ref": "#/$defs/stringOrPlaceholder" },
        "export_matrix": { "$ref": "#/$defs/stringOrPlaceholder" },
        "check_uniqueness": { "$ref": "#/$defs/stringOrPlaceholder" },
        "check_glossary": { "const": "scripts/check-glossary.sh" },
        "check_nfr_fields": { "const": "scripts/check-nfr-fields.sh" },
        "check_traceability": { "const": "scripts/check-traceability.sh" }
      }
    },
    "nfr_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_for_types", "fields"],
      "properties": {
        "required_for_types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^NFR-[A-Z]+$" }
        },
        "fields": {
          "type": "array",
          "minItems": 3,
          "items": { "enum": ["METRIC", "THRESHOLD", "MEASUREMENT_METHOD"] },
          "uniqueItems": true
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_orphan_marker", "on_missing_marker", "on_duplicate_uid", "on_missing_nfr_field", "on_undefined_glossary_term"],
      "properties": {
        "on_orphan_marker": { "const": "hard-gate" },
        "on_missing_marker": { "const": "hard-gate" },
        "on_duplicate_uid": { "const": "hard-gate" },
        "on_missing_nfr_field": { "const": "hard-gate" },
        "on_undefined_glossary_term": { "const": "hard-gate" }
      }
    }
  },
  "$defs": {
    "stringOrPlaceholder": {
      "type": "string",
      "minLength": 1
    }
  }
}
